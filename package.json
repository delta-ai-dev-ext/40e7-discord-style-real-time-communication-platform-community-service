{
  "name": "community-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --target bun --outdir ./dist --sourcemap=external",
    "test": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.30",
    "kafkajs": "^2.2.4",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
